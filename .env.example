# ===== Qdrant =====
# Use "http://localhost:6333" with docker compose, or ":memory:" for tests/dev without persistence.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ===== LLM (OpenAI-compatible: DeepSeek / OpenAI / Moonshot / ...) =====
# For DeepSeek:
#   OPENAI_BASE_URL=https://api.deepseek.com/v1
#   DEFAULT_GENERATION_MODEL=deepseek-v4-pro
# For OpenAI: leave OPENAI_BASE_URL empty, DEFAULT_GENERATION_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1
ANTHROPIC_API_KEY=

# Chat provider/model
DEFAULT_LLM_PROVIDER=openai
DEFAULT_GENERATION_MODEL=deepseek-v4-pro

# ===== Embeddings =====
# DeepSeek has no embeddings API, so default to a local HuggingFace model (free, no key).
# Supported: huggingface | openai
DEFAULT_EMBEDDING_PROVIDER=huggingface
DEFAULT_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# HuggingFace download mirror (helpful in China). Set empty to use the default endpoint.
HUGGINGFACE_ENDPOINT=https://hf-mirror.com

# Required before saving API keys through the Web UI. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROVIDER_ENCRYPTION_KEY=
# Allow a custom provider hosted on a private LAN. Loopback (localhost) is always allowed.
ALLOW_PRIVATE_PROVIDER_URLS=false

# ===== Local persistence =====
DATABASE_URL=sqlite:///./data/chatmaster.db
STORAGE_DIR=data/storage
LOCAL_WORKSPACE_ID=local
LOCAL_USER_ID=local-user

# ===== RAG =====
COMMON_COLLECTION=chatmaster_common
COMMON_TOP_K=4
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ===== Server =====
CORS_ORIGINS=["http://localhost:5173"]
UPLOAD_MAX_BYTES=26214400
UPLOAD_BATCH_MAX_BYTES=104857600
INGEST_WORKERS=2
CHAT_HISTORY_MAX_MESSAGES=40
CHAT_HISTORY_MAX_CHARS=40000
CHAT_MESSAGE_MAX_CHARS=20000
